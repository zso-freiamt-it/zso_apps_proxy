[Unit]
Description=Service for ZSKarte
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/home/zso/zso_apps_proxy
ExecStart=bash zso_traefik.sh start
ExecStop=bash zso_traefik.sh stop
StandardOutput=syslog
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
