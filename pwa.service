[Unit]
Description=Service for ZSKarte
Requires=traefik.service
After=traefik.service

[Service]
Type=oneshot
WorkingDirectory=/home/zso/zso_apps_proxy
ExecStart=bash zso_pwa_app.sh start
ExecStop=bash zso_pwa_app.sh stop
StandardOutput=syslog
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
